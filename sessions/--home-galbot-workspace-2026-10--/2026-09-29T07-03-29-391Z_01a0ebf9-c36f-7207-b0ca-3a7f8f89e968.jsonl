{"type":"message","id":"305510a3","parentId":"b333bad6","timestamp":"2026-09-29T07:14:06.809Z","message":{"role":"toolResult","toolCallId":"call_7c31a1eeaee14b51b2684745","toolName":"read","content":[{"type":"text","text":"\"\"\"统一日志工具 — 通过环境变量 LOG_LEVEL 控制详细程度。\n\n用法:\n    from src.logger import get_logger\n    log = get_logger(\"TTS\")          # 组件名，作为日志前缀\n\n    log.info(\"HTTP 200 OK\")          # 默认会打印\n    log.debug(\"POST URL: ...\")       # 只在 LOG_LEVEL=debug 时打印\n    log.warn(\"retry...\")             # warn 及以上一直打印\n    log.error(\"auth failed\")         # error 一直打印\n\n环境变量:\n    LOG_LEVEL=debug  — 全部日志（debug + info + warn + error）\n    LOG_LEVEL=info   — 默认。只打 info / warn / error\n    LOG_LEVEL=warn   — 只打 warn / error\n    LOG_LEVEL=error  — 只打 error\n\n约定:\n    info  = 用户关心的关键事件（动作触发、播放开始、总耗时）\n    debug = 开发者排错用的细节（HTTP headers、延迟分段、每段 chunk 数）\n    warn  = 异常但不致命（重试、跳过）\n    error = 致命错误（请求失败、配置错误）\n\"\"\"\nimport os\nimport sys\nfrom datetime import datetime\n\n\n_LEVELS = {\"debug\": 10, \"info\": 20, \"warn\": 30, \"error\": 40}\n_CURRENT_LEVEL = _LEVELS.get(os.getenv(\"LOG_LEVEL\", \"info\").lower(), 20)\n_FILE_SINK_DISABLED = False\n_APP_LOG_ENV = \"GALBOT_RUNTIME_APP_LOG\"\n\n\ndef _runtime_app_log_enabled() -> bool:\n    return os.getenv(_APP_LOG_ENV, \"\").strip().lower() in {\"1\", \"true\", \"yes\", \"on\"}\n\n\ndef _append_runtime_app_log(line: str) -> None:\n    global _FILE_SINK_DISABLED\n    if _FILE_SINK_DISABLED or not _runtime_app_log_enabled():\n        return\n    try:\n        from src.runtime import runtime_logger\n\n        if not runtime_logger.app_log_enabled():\n            return\n        path = runtime_logger.app_log_path()\n        from src.runtime import io_worker\n\n        io_worker.append_text(path, f\"{line}\\n\", priority=90)\n    except Exception:\n        # Logging must never break robot runtime behavior. If this environment\n        # cannot create the sink, stop retrying to avoid repeated hot-path cost.\n        _FILE_SINK_DISABLED = True\n\n\ndef _emit(level_value: int, prefix: str, msg: str) -> None:\n    if level_value >= _CURRENT_LEVEL:\n        level_name = {10: \"DEBUG\", 20: \"INFO\", 30: \"WARNING\", 40: \"ERROR\"}[level_value]\n        timestamp = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S,%f\")[:-3]\n        line = f\"{timestamp} [{level_name}] [{prefix}] {msg}\"\n        # error 走 stderr，其余走 stdout — 方便管道过滤\n        stream = sys.stderr if level_value >= 40 else sys.stdout\n        print(line, file=stream, flush=True)\n        _append_runtime_app_log(line)\n\n\nclass _Logger:\n    __slots__ = (\"component\",)\n\n    def __init__(self, component: str):\n        self.component = component\n\n    def debug(self, msg: str) -> None:\n        _emit(10, self.component, msg)\n\n    def info(self, msg: str) -> None:\n        _emit(20, self.component, msg)\n\n    def warn(self, msg: str) -> None:\n        _emit(30, self.component, f\"⚠️ {msg}\")\n\n    def error(self, msg: str) -> None:\n        _emit(40, self.component, f\"❌ {msg}\")\n\n\ndef get_logger(component: str) -> _Logger:\n    return _Logger(component)\n\n\ndef current_level() -> str:\n    \"\"\"返回当前生效的日志级别字符串。\"\"\"\n    inv = {v: k for k, v in _LEVELS.items()}\n    return inv.get(_CURRENT_LEVEL, \"info\")\n"}],"isError":false,"timestamp":1790666046809}}
